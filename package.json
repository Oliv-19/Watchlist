{
  "name": "watchlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "worker": "pnpm run build && wrangler dev",
    "dryrun:staging": "pnpm run build && wrangler deploy --dry-run --env staging",
    "dryrun:prod": "pnpm run build && wrangler deploy --dry-run --env production",
    "deploy:staging": "pnpm run build && wrangler deploy --env staging",
    "deploy:prod": "pnpm run build && wrangler deploy --env production",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply watchlist_local_db --local",
    "db:migrate:staging": "wrangler d1 migrations apply watchlist_staging_db --remote --env staging",
    "db:migrate": "pnpm run db:migrate:local && wrangler d1 migrations apply watchlist_staging_db --remote --env staging"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.16.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10",
    "wrangler": "^4.90.0"
  }
}
