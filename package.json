{
  "name": "watchlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "worker": "pnpm run build && wrangler dev",
    "dryrun": "pnpm run build && wrangler deploy --dry-run --env production",
    "deploy": "pnpm run build && wrangler deploy --env production",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply watchlist_prod_db --local",
    "db:migrate": "pnpm run db:migrate:local && wrangler d1 migrations apply watchlist_prod_db --remote --env production",
    "db:migrate:prod": "wrangler d1 migrations apply watchlist_prod_db --remote --env production"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
